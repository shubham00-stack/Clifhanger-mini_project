# Application Configuration
APP_ENV=production
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=INFO

# Security & CORS
MAX_PAYLOAD_BYTES=10485760
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# NVIDIA NIM Provider Configuration
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Configurable NVIDIA NIM Models (Section 4.2)
MODEL_PRIMARY_NARRATIVE=nvidia/nemotron-3-nano-omni-30b-a3b-instruct
MODEL_FAST_TEXT=nvidia/nemotron-3.5-bolt-e4b
MODEL_EMBEDDINGS=nvidia/nemotron-3.5-embed-1b
MODEL_RERANKER=nvidia/nemotron-3.5-rerank-8b
MODEL_OCR_PARSER=nvidia/nemotron-3.5-parse

# Resilience & Retries
MAX_RETRIES=3
RETRY_BASE_DELAY=0.5
RETRY_MAX_DELAY=4.0
